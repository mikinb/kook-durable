# Copy to .env if you need to override defaults. The defaults in code already
# match docker-compose.yml, so this file is optional for local runs.
DATABASE_URL=postgresql+asyncpg://durable:durable_local_only@localhost:54329/durable_demo
TEST_DATABASE_URL=postgresql+asyncpg://durable:durable_local_only@localhost:54329/durable_test
LOG_LEVEL=INFO
# Placeholder credential for the fake external service. Never commit a real key.
EXTERNAL_SERVICE_API_KEY=demo-placeholder-not-a-real-key
